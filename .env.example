# Opcional: si se define, Java debe enviar Authorization: Bearer <token>.
SERVICE_TOKEN=

# Umbrales de afinidad heurística.
SCORE_HIGH_THRESHOLD=60
SCORE_MEDIUM_THRESHOLD=30

# Límite de entrada para proteger el servicio.
MAX_CANDIDATES=200

# Tamaño máximo del cuerpo HTTP en bytes (200 candidatos ocupan ~30 KB).
MAX_BODY_BYTES=65536

# Desactivar documentación interactiva en despliegue público.
DOCS_ENABLED=true
